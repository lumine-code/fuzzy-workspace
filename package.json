{
  "name": "fuzzy-workspace",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Quickly find and focus any open item across the workspace.",
  "keywords": [
    "switcher",
    "pane",
    "focus",
    "open-item",
    "navigation"
  ],
  "repository": "https://github.com/lumine-code/fuzzy-workspace",
  "bugs": {
    "url": "https://github.com/lumine-code/fuzzy-workspace/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "backgroundTips": [
    "You can jump to anything already open in the workspace with {{ 'fuzzy-workspace:toggle' | keystroke }}"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "activationCommands": {
    "lumine-workspace": [
      "fuzzy-workspace:toggle"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
