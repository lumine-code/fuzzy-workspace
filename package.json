{
  "name": "fuzzy-workspace",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Quickly find and focus any open item across the workspace.",
  "keywords": [
    "switcher",
    "pane",
    "focus",
    "open-item",
    "navigation"
  ],
  "repository": "https://github.com/lumine-code/fuzzy-workspace",
  "bugs": {
    "url": "https://github.com/lumine-code/fuzzy-workspace/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "recentCount": {
      "title": "Number of Recent Items",
      "description": "How many recently used items to keep at the top of the list.",
      "type": "integer",
      "minimum": 0,
      "default": 10
    }
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
